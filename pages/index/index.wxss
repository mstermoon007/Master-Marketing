/* ===== 首页：渐变 Hero + 悬浮表单卡 ===== */
.boot-loading {
  text-align: center;
  color: var(--text-weak);
  padding: 120rpx 0;
  font-size: 26rpx;
}

.home {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 48rpx;
}

.hero {
  background: linear-gradient(140deg, #4a7cf7 0%, #6a9bff 78%, #86abff 100%);
  padding: 44rpx 40rpx 84rpx;
  position: relative;
}

.hero::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 44rpx;
  background: var(--bg);
  border-radius: 44rpx 44rpx 0 0;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title-en {
  color: rgba(255, 255, 255, 0.55);
  font-size: 18rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
}

.hero-team {
  display: flex;
  align-items: center;
}

.hero-team-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.hero-role {
  color: rgba(255, 255, 255, 0.92);
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.hero-user {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.hero-date-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.date-picker {
  display: flex;
  align-items: baseline;
  padding: 0 8rpx;
}

.hero-date {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-week {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-left: 14rpx;
}

.date-edit {
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  margin-left: 16rpx;
  border-bottom: 2rpx dashed rgba(255, 255, 255, 0.6);
}

.date-arrow {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 40rpx;
  flex-shrink: 0;
}

.date-arrow-off {
  opacity: 0.35;
}

.backfill-tag {
  margin-left: 16rpx;
  background: #ffd66b;
  color: #7a5200;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.hero-status {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffd66b;
  margin-right: 12rpx;
}

.status-dot-ok {
  background: #7dffb2;
}

.loading-block {
  padding: 80rpx 0;
}

/* ===== 表单卡 ===== */
.form-card {
  margin: -44rpx 24rpx 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(74, 124, 247, 0.12);
  padding: 32rpx;
  position: relative;
  z-index: 2;
}

.form-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
  margin-bottom: 28rpx;
}

.form-title-wrap {
  display: flex;
  align-items: center;
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 12rpx;
}

.ver-tag {
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-weak);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.form-state {
  font-size: 24rpx;
  color: var(--warn);
  background: #fdf4e7;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.form-state-ok {
  color: var(--ok);
  background: #e8f7ef;
}

.hint-banner {
  background: #fdf4e7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.hint-text {
  color: var(--warn);
  font-size: 24rpx;
}

.submit-area {
  margin-top: 36rpx;
}

.btn-submit {
  background: linear-gradient(135deg, #4a7cf7, #6a9bff);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(74, 124, 247, 0.3);
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  opacity: 0.6;
  color: #ffffff;
}

.btn-draft {
  margin-top: 16rpx;
  width: 100%;
  background: var(--brand-weak);
  color: var(--brand);
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.btn-draft::after {
  border: none;
}

.btn-draft[disabled] {
  opacity: 0.6;
}

/* ===== 无模板兜底 ===== */
.fallback-icon {
  text-align: center;
  font-size: 72rpx;
  padding: 24rpx 0 8rpx;
}

.fallback-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.fallback-desc {
  text-align: center;
  color: var(--text-weak);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* ===== 管理入口 ===== */
.admin-card {
  margin: 0 24rpx;
  border-radius: 28rpx;
}

.admin-card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.admin-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.admin-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.admin-item-main {
  flex: 1;
}

.admin-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.admin-desc {
  display: block;
  color: var(--text-weak);
  font-size: 24rpx;
  margin-top: 4rpx;
}

.admin-arrow {
  color: var(--text-weak);
  font-size: 40rpx;
  margin-left: 16rpx;
}

/* ===== 错误 ===== */
.err-card {
  margin: 0 24rpx 24rpx;
  background: #fdf0f0;
  border-radius: 20rpx;
}

.err-text {
  color: var(--danger);
  font-size: 26rpx;
}

/* ===== 登录 / 团队引导页 ===== */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #eef3ff 0%, var(--bg) 42%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-logo-ring {
  width: 168rpx;
  height: 168rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #4a7cf7, #6a9bff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(74, 124, 247, 0.3);
  margin-bottom: 36rpx;
}

.login-logo {
  font-size: 80rpx;
}

.login-title {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text);
}

.login-desc {
  color: var(--text-sub);
  font-size: 26rpx;
  margin-top: 14rpx;
}

.login-card {
  width: 100%;
  box-sizing: border-box;
  padding: 0 60rpx;
  margin-top: 88rpx;
}

.login-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.login-error {
  color: var(--danger);
  font-size: 24rpx;
  text-align: center;
  display: block;
}
