<view class="page">
  <view wx:if="{{checking}}" class="empty">加载中…</view>

  <block wx:else>
    <!-- 已有组织：当前空间 + 空间/团队切换 -->
    <block wx:if="{{hasOrg}}">
      <view class="card" wx:if="{{workspace}}">
        <view class="card-title">当前工作空间</view>
        <view class="space-line">
          <text class="space-name">{{workspace.name}}</text>
          <text class="tag tag-brand">{{workspaceRoleText}}</text>
        </view>
        <view class="weak">空间编码：{{workspace.workspace_code}}</view>
      </view>

      <view class="card" wx:if="{{spaces.length}}">
        <view class="card-title">我的工作空间</view>
        <view class="space-block" wx:for="{{spaces}}" wx:key="index">
          <view class="space-head" data-workspaceId="{{item.workspace.id}}" bindtap="doSwitchSpace">
            <text class="space-name">{{item.workspace.name}}</text>
            <text class="tag tag-gray">{{item.role === 'owner' ? '所有者' : (item.role === 'admin' ? '管理员' : (item.role === 'viewer' ? '只读' : '成员'))}}</text>
            <text class="menu-arrow" wx:if="{{item.workspace.id !== currentWorkspaceId}}">›</text>
          </view>
          <view
            wx:for="{{item.teams}}"
            wx:for-item="team"
            wx:key="team_id"
            class="team-row {{team.team_id === currentTeamId ? 'team-active' : ''}}"
            data-teamId="{{team.team_id}}"
            bindtap="doSwitchTeam"
          >
            <text>{{team.name}}</text>
            <text class="weak">{{team.team_id}}</text>
          </view>
          <view class="weak" wx:if="{{!item.teams.length}}">该空间下暂无你可见的团队</view>
        </view>
      </view>
    </block>

    <view class="tab-switch">
      <view class="tab-item {{mode === 'join' ? 'tab-active' : ''}}" data-mode="join" bindtap="switchMode">加入团队</view>
      <view class="tab-item {{mode === 'create' ? 'tab-active' : ''}}" data-mode="create" bindtap="switchMode">新建团队</view>
      <view class="tab-item {{mode === 'workspace' ? 'tab-active' : ''}}" data-mode="workspace" bindtap="switchMode">新建空间</view>
    </view>

    <view class="card">
      <view class="form-line">
        <text class="form-label">我的姓名</text>
        <input class="input" value="{{myName}}" placeholder="团队内显示的名字" bindinput="onMyName" />
      </view>

      <block wx:if="{{mode === 'join'}}">
        <view class="form-line">
          <text class="form-label">邀请码</text>
          <input class="input" value="{{inviteCode}}" placeholder="向负责人索取，如 T4K7QX" bindinput="onInviteCode" />
        </view>
        <button class="btn-primary" bindtap="doJoin" loading="{{busy}}" disabled="{{busy}}">加入团队</button>
      </block>

      <block wx:elif="{{mode === 'create'}}">
        <view class="form-line">
          <text class="form-label">团队名称</text>
          <input class="input" value="{{teamName}}" placeholder="如：销售一组" bindinput="onTeamName" />
        </view>
        <button class="btn-primary" bindtap="doCreate" loading="{{busy}}" disabled="{{busy}}">创建团队</button>
        <view class="section-gap"></view>
        <text class="weak">未指定工作空间时，会自动创建一个同名工作空间；创建后你将成为团队负责人。</text>
      </block>

      <block wx:else>
        <view class="form-line">
          <text class="form-label">工作空间名称</text>
          <input class="input" value="{{workspaceName}}" placeholder="如：华东销售中心" bindinput="onWorkspaceName" />
        </view>
        <view class="form-line">
          <text class="form-label">首个团队名称（可选）</text>
          <input class="input" value="{{teamName}}" placeholder="留空则先只建空间" bindinput="onTeamName" />
        </view>
        <button class="btn-primary" bindtap="doCreateWorkspace" loading="{{busy}}" disabled="{{busy}}">创建工作空间</button>
        <view class="section-gap"></view>
        <text class="weak">创建后你将成为空间所有者，可继续新建团队、部门并邀请成员。</text>
      </block>

      <view class="section-gap"></view>
      <text class="error-text" wx:if="{{errorText}}">{{errorText}}</text>
    </view>
  </block>
</view>
