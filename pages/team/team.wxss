.tab-switch {
  display: flex;
  background: #eef0f4;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
}

.tab-active {
  background: #ffffff;
  color: var(--brand);
  font-weight: 600;
}

.form-line {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 10rpx;
}

.error-text {
  color: var(--danger);
  font-size: 26rpx;
}
