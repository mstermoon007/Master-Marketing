.tab-switch {
  display: flex;
  background: #eef0f4;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-sub);
  border-radius: 12rpx;
}

.tab-active {
  background: #ffffff;
  color: var(--brand);
  font-weight: 600;
}

.form-line {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 10rpx;
}

.error-text {
  color: var(--danger);
  font-size: 26rpx;
}

.space-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.space-name {
  font-size: 30rpx;
  font-weight: 600;
}

.space-block {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.space-block:last-child {
  border-bottom: none;
}

.space-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
}

.team-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-top: 10rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
}

.team-active {
  background: var(--brand-weak);
}

.menu-arrow {
  margin-left: auto;
  color: var(--text-weak);
  font-size: 36rpx;
}
