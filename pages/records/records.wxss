.record-item {
  margin-bottom: 20rpx;
}

.record-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.record-date {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: auto;
}

.record-date-link {
  color: var(--brand);
}

.backfill-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 20rpx;
}

.btn-backfill {
  margin: 0;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--brand-weak);
  border-radius: 999rpx;
  border: none;
}

.btn-backfill::after {
  border: none;
}

.record-summary {
  display: block;
  color: var(--text-sub);
  font-size: 26rpx;
  margin-bottom: 6rpx;
}

.record-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-tpl {
  color: var(--text-weak);
  font-size: 22rpx;
  max-width: 45%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ===== 筛选区 ===== */
.filter-bar {
  margin: 0 24rpx 16rpx;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.pill {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--text-sub);
  font-size: 24rpx;
  border: 1rpx solid var(--border, #ebeef5);
}

.pill-on {
  background: var(--brand);
  color: #ffffff;
  border-color: var(--brand);
}

.filter-template {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid var(--border, #ebeef5);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.filter-arrow {
  color: var(--text-weak);
}

.filter-count {
  display: block;
  color: var(--text-weak);
  font-size: 22rpx;
  margin-top: 4rpx;
}
