.form-line {
  margin-bottom: 22rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.form-two {
  display: flex;
  gap: 24rpx;
}

.form-two .form-line {
  flex: 1;
}

.picker-box {
  background: #f4f6fa;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-small {
  padding: 10rpx 20rpx;
  display: inline-flex;
}

.arrow {
  color: var(--text-weak);
}

.scope-block {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.scope-check {
  display: inline-flex;
  align-items: center;
  margin: 8rpx 28rpx 8rpx 0;
  font-size: 26rpx;
}

.scope-member {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.field-card {
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.field-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-sort {
  font-size: 28rpx;
  font-weight: 600;
}

.field-head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.field-expand {
  color: var(--brand);
  font-size: 24rpx;
}

.agg-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.agg-line .form-label {
  margin-bottom: 0;
}

.agg-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-ops {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.act {
  font-size: 24rpx;
  color: var(--brand);
}

.act-del {
  color: var(--danger);
}

.add-field-btn {
  margin-top: 8rpx;
}

.draft-save-btn {
  margin-top: 16rpx;
}
