# ============================================================
# 报数机器人AI · 部署环境变量模板
# 首次部署：cp .env.example .env  然后填真实值
# 本地开发：同样用法，server/ 下 python -m app.init_db + uvicorn
#
# ⚠ 本文件含真实密钥时切勿提交到仓库
# ============================================================

# ---- 数据库（MySQL 8）----
# Docker Compose 内 backend 容器通过网络名 mysql 访问 MySQL，
# DB_HOST/DB_PORT 在 docker-compose.yml 的 environment 里显式覆盖为 mysql:3306
# （本机开发时才用 127.0.0.1:3306）
DB_USER=jinribao
DB_PASSWORD=change-me-please
DB_NAME=jinribao
# Docker Compose 宿主机端口映射（避开 feasibility 项目占用的端口）
DB_HOST_PORT=3307

# ---- 微信小程序 ----
WX_APPID=wx6359d33c631cec4d
WX_SECRET=replace-with-your-appsecret-from-mp.weixin.qq.com
WX_HTTP_TIMEOUT=5

# ---- JWT 签名（openssl rand -hex 32 生成；少于 32 字符启动会拒绝）----
JWT_SECRET=replace-with-a-long-random-string-32bytes-minimum
JWT_TTL_DAYS=30

# ---- Web 管理后台（P5）----
# Web 与 API 同域部署；空间 owner/admin 或团队 owner/manager 可扫码登录
WEB_ORIGIN=https://api.modouyu.top
WEB_TOKEN_TTL_HOURS=12

# ---- 消息通知（P6）----
# 微信订阅消息模板 ID：先在公众平台申请模板，再把 ID 填到这里。
# 【唯一配置源】小程序已不再维护第二份模板 ID，首页通过 getSubscribeTemplates 自动拉取。
# 任一项留空时该类型只写通知记录（status=skipped），不会调用微信。
# 模板字段约定（四类统一）：thing1=团队名、thing2=任务/提醒标题、date3=日期、number4=人次。
WX_TMPL_DAILY_REMIND=
WX_TMPL_DUE_REMIND=
WX_TMPL_MISSING_REMIND=
WX_TMPL_ANOMALY_ALERT=

# 定时调度已拆分到独立 scheduler 容器（见 docker-compose.yml）：
# backend 固定 SCHEDULER_ENABLED=0，scheduler 固定 =1，此处无需配置该开关。
SCHEDULER_TZ=Asia/Shanghai
DAILY_REMIND_TIME=09:00
MISSING_REMIND_TIME=20:00
REMIND_BEFORE_MINUTES=30

# ---- 服务 ----
BACKEND_HOST_PORT=8001
