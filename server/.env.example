# ============================================================
# 报数机器人AI · 部署环境变量模板
# 首次部署：cp .env.example .env  然后填真实值
# 本地开发：同样用法，server/ 下 python -m app.init_db + uvicorn
#
# ⚠ 本文件含真实密钥时切勿提交到仓库
# ============================================================

# ---- 数据库（MySQL 8）----
# Docker Compose 内 backend 容器通过网络名 mysql 访问 MySQL，
# DB_HOST/DB_PORT 在 docker-compose.yml 的 environment 里显式覆盖为 mysql:3306
# （本机开发时才用 127.0.0.1:3306）
DB_USER=jinribao
DB_PASSWORD=change-me-please
DB_NAME=jinribao
# Docker Compose 宿主机端口映射（避开 feasibility 项目占用的端口）
DB_HOST_PORT=3307

# ---- 微信小程序 ----
WX_APPID=wx6359d33c631cec4d
WX_SECRET=replace-with-your-appsecret-from-mp.weixin.qq.com
WX_HTTP_TIMEOUT=5

# ---- JWT 签名（用 openssl rand -hex 32 生成）----
JWT_SECRET=replace-with-a-long-random-string-32bytes-minimum
JWT_TTL_DAYS=30

# ---- 服务 ----
BACKEND_HOST_PORT=8001
